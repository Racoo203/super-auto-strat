# Copy to .env (git-ignored) and edit. Read by compose.yaml and the Makefile.
# Keep comments on their own lines (no "VALUE  # comment").

# --- the training run (agents/ppo/run.py) ---
# Output goes to runs/<RUN_NAME>/. Use a new name to start a new run; keep it to resume.
RUN_NAME=server-selfplay-01
UPDATES=5000
# Env worker processes; about the number of physical CPU cores is a good start.
N_ENVS=8
N_POLICIES=1
OPPONENT=ghosts
SEED=0
# Any other run.py flags, e.g. --lr 1e-4 --eval-every 50
EXTRA_ARGS=

# --- dashboards ---
# 127.0.0.1: reachable only from the server itself (use an SSH tunnel, see deploy/README.md).
# 0.0.0.0: exposed to your LAN. They have no authentication.
BIND_ADDR=127.0.0.1
TB_PORT=6006
OPTUNA_PORT=8080

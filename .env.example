# Copy to .env (git-ignored) and edit. Read by compose.yaml and the Makefile.
# Keep comments on their own lines (no "VALUE  # comment").

# --- the training run (agents/ppo/run.py) ---
# Output goes to runs/<RUN_NAME>/. Use a new name to start a new run; keep it to resume.
RUN_NAME=server-selfplay-01
UPDATES=5000
# Env worker processes; about the number of physical CPU cores is a good start.
N_ENVS=8
N_POLICIES=1
OPPONENT=ghosts
SEED=0
# Any other run.py flags (python -m agents.ppo.run --help). Keep them the same for the whole
# run: they are re-read on every restart. No quotes. Examples:
#   EXTRA_ARGS=--from-trial ppo-tune:7
#   EXTRA_ARGS=--lr 1e-4 --entropy-coef 0.02 --clip-eps 0.15 --gae-lambda 0.93 --n-epochs 6
#   EXTRA_ARGS=--params-json runs/final-params.json
EXTRA_ARGS=

# --- tuning: make tune / make validate (they pass --n-envs $N_ENVS themselves) ---
# Rerunning `make tune` continues the study and runs --trials more trials.
TUNE_ARGS=--trials 20 --updates 200
# Top 3 tuning trials x seeds 1 2 3, 500 updates each.
VALIDATE_ARGS=--top 3 --seeds 1 2 3 --updates 500

# --- dashboards ---
# 127.0.0.1: reachable only from the server itself (use an SSH tunnel, see deploy/README.md).
# 0.0.0.0: exposed to your LAN. They have no authentication.
BIND_ADDR=127.0.0.1
TB_PORT=6006
OPTUNA_PORT=8080
